<!DOCTYPE html>
<html>
<head>
    <title>西西的贪吃蛇</title>
    <script src="https://cdn.jsdelivr.net/npm/brython@3.11.1/brython.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/brython@3.11.1/brython_stdlib.js"></script>
    <style>
        /* 全局样式（两个页面共用） */
        :root {
            --bg-color: #f0f8ff;
            --container-bg: #fffacd;
            --accent-color: #ff6b6b;
            --button-color: #06d6a0;
            --button-hover: #05b98b;
            --border-color: #ffd166;
            --text-color: #457b9d;
            --card-bg: #f8f9fa;
            --shadow: 0 3px 8px rgba(0,0,0,0.15);
            --radius: 20px;
        }
        body { 
            text-align: center; 
            background-color: var(--bg-color); 
            font-family: "Comic Sans MS", "Marker Felt", sans-serif;
            margin: 0;
            padding: 20px 0;
        }
        .container {
            display: inline-block;
            padding: 25px;
            background-color: var(--container-bg);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
        }
        h2 {
            color: var(--accent-color);
            text-shadow: 2px 2px 3px rgba(0,0,0,0.1);
            margin: 0 0 20px 0;
            font-size: 28px;
        }
        button { 
            margin: 0 8px; 
            padding: 8px 16px; 
            font-size: 16px; 
            cursor: pointer;
            background-color: var(--button-color);
            color: white;
            border: none;
            border-radius: 20px;
            font-family: "Comic Sans MS", sans-serif;
            box-shadow: 0 3px 5px rgba(0,0,0,0.2);
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 8px rgba(0,0,0,0.2);
            background-color: var(--button-hover);
        }
        .controls { 
            margin: 15px 0; 
        }
        p {
            color: var(--text-color);
            font-size: 18px;
            margin: 10px 0;
        }
        .link-btn {
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        .player-input {
            margin: 15px 0;
        }
        input {
            padding: 6px 10px;
            border: 2px solid var(--button-color);
            border-radius: 15px;
            font-family: "Comic Sans MS", sans-serif;
            margin-right: 10px;
            font-size: 16px;
        }
        canvas { 
            border: 5px solid var(--border-color); 
            border-radius: 15px;
            background-color: #e6f7ee;
        }
    </style>
</head>
<body onload="brython()">
    <div class="container">
        <h2>🐍 西西设计的贪吃蛇 🐍</h2>
        <canvas id="game" width="580" height="320"></canvas>
        <div class="controls">
            <button id="restart">
                <span>🔄</span> 重新开始
            </button>
            <button id="toggleMusic">
                <span>🔊</span> 开启音乐
            </button>
            <a href="ranking.html" class="link-btn button" style="background-color: #118ab2; color: white; padding: 8px 16px; border-radius: 20px;">
                <span>🏆</span> 查看排行榜
            </a>
        </div>
        <p>方向键控制蛇蛇移动~ 吃到食物会变长哦！</p>
        
        <!-- 游戏结束后显示的玩家输入框 -->
        <div id="player-input" class="player-input" style="display: none;">
            <input type="text" id="player-name" placeholder="输入你的名字">
            <button id="save-score">
                <span>💾</span> 保存分数
            </button>
        </div>
    </div>
    
    <!-- 背景音乐 -->
    <audio id="bgm" loop>
        <source src="https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3" type="audio/mpeg">
    </audio>

    <audio id="hoverSound" src="eat.mp3" style="display:none"></audio>

    <script type="text/python">
        from browser import document, window, timer
        import random

        #新加lxl
        sound = document["hoverSound"]

        # 保存分数到本地存储
        def save_score(name, score):
            if score <= 0:
                return
            stored = window.localStorage.getItem("snake_ranking")
            ranking_data = eval(stored) if stored else []
            ranking_data.append({"name": name, "score": score})
            window.localStorage.setItem("snake_ranking", str(ranking_data))

        # 游戏参数初始化
        def init_game():
            global snake, direction, food, score, game_over, game_loop, music_on
            snake = [(100, 100), (80, 100), (60, 100)]
            direction = (20, 0)
            food = (200, 200)
            score = 0
            game_over = False
            music_on = False
            document["toggleMusic"].innerHTML = "<span>🔊</span> 开启音乐"
            document["player-input"].style.display = "none"
            
            # 音乐控制
            bgm = document["bgm"]
            bgm.currentTime = 0
            if music_on:
                bgm.play()
            
            if 'game_loop' in globals():
                timer.clear_interval(game_loop)
            game_loop = timer.set_interval(update, 150)

        # 画布初始化
        canvas = document["game"]
        ctx = canvas.getContext("2d")
        grid_size = 20
        width, height = 580, 320

        # 绘制蛇
        def draw_snake():
            # 蛇头
            head_x, head_y = snake[0]
            ctx.fillStyle = "#2a9d8f"
            rounded_rect(ctx, head_x, head_y, grid_size-1, grid_size-1, 8)
            
            # 蛇身
            for i in range(1, len(snake)):
                x, y = snake[i]
                color = f"hsl(120, 70%, {70 - i*2}%)"
                ctx.fillStyle = color
                rounded_rect(ctx, x, y, grid_size-1, grid_size-1, 5)
                
                # 蛇身亮点
                ctx.fillStyle = "rgba(255,255,255,0.3)"
                ctx.beginPath()
                ctx.arc(x + 5, y + 5, 3, 0, 2*3.14)
                ctx.fill()

        # 绘制食物
        def draw_food():
            x, y = food
            ctx.fillStyle = "#f72585"
            ctx.beginPath()
            ctx.arc(x + grid_size//2, y + grid_size//2, grid_size//2 - 1, 0, 2*3.14)
            ctx.fill()
            
            # 食物表情
            ctx.fillStyle = "white"
            ctx.beginPath()
            ctx.arc(x + grid_size//3, y + grid_size//3, 2, 0, 2*3.14)  # 左眼
            ctx.arc(x + grid_size*2//3, y + grid_size//3, 2, 0, 2*3.14)  # 右眼
            ctx.fill()
            
            # 微笑嘴
            ctx.strokeStyle = "white"
            ctx.lineWidth = 1.5
            ctx.beginPath()
            ctx.arc(x + grid_size//2, y + grid_size*2//3, 5, 0.1*3.14, 0.9*3.14)
            ctx.stroke()

        # 圆角矩形辅助函数
        def rounded_rect(ctx, x, y, width, height, radius):
            ctx.beginPath()
            ctx.moveTo(x + radius, y)
            ctx.lineTo(x + width - radius, y)
            ctx.arcTo(x + width, y, x + width, y + radius, radius)
            ctx.lineTo(x + width, y + height - radius)
            ctx.arcTo(x + width, y + height, x + width - radius, y + height, radius)
            ctx.lineTo(x + radius, y + height)
            ctx.arcTo(x, y + height, x, y + height - radius, radius)
            ctx.lineTo(x, y + radius)
            ctx.arcTo(x, y, x + radius, y, radius)
            ctx.closePath()
            ctx.fill()

        # 移动逻辑
        def move_snake():
            global food, score, game_over
            head_x, head_y = snake[0]
            dx, dy = direction
            new_head = (head_x + dx, head_y + dy)

            if (new_head[0] < 0 or new_head[0] >= width or
                new_head[1] < 0 or new_head[1] >= height or
                new_head in snake):
                game_over = True
                document["player-input"].style.display = "block"
                return

            snake.insert(0, new_head)
            if new_head == food:
                score += 10
                #新加lxl
                sound.play()

                while True:
                    food = (random.randint(0, (width//grid_size)-1) * grid_size,
                            random.randint(0, (height//grid_size)-1) * grid_size)
                    if food not in snake:
                        break
            else:
                snake.pop()

        # 更新游戏状态
        def update():
            if game_over:
                ctx.fillStyle = "#e63946"
                ctx.font = "bold 24px 'Comic Sans MS'"
                ctx.textAlign = "center"
                ctx.fillText(f"游戏结束！", width//2, height//2 - 20)
                ctx.fillText(f"分数: {score}", width//2, height//2 + 20)
                ctx.textAlign = "start"
                return

            ctx.fillStyle = "#e6f7ee"
            ctx.fillRect(0, 0, width, height)
            move_snake()
            draw_snake()
            draw_food()

            # 显示分数
            ctx.fillStyle = var(--text-color)
            ctx.font = "bold 20px 'Comic Sans MS'"
            ctx.fillText(f"分数: {score}", 10, 30)

        # 键盘控制
        def handle_key(e):
            global direction
            key = e.key
            if key == "ArrowUp" and direction != (0, grid_size):
                direction = (0, -grid_size)
            elif key == "ArrowDown" and direction != (0, -grid_size):
                direction = (0, grid_size)
            elif key == "ArrowLeft" and direction != (grid_size, 0):
                direction = (-grid_size, 0)
            elif key == "ArrowRight" and direction != (-grid_size, 0):
                direction = (grid_size, 0)

        # 音乐控制
        def toggle_music(e):
            global music_on
            bgm = document["bgm"]
            music_on = not music_on
            if music_on:
                bgm.play()
                document["toggleMusic"].innerHTML = "<span>🔇</span> 关闭音乐"
            else:
                bgm.pause()
                document["toggleMusic"].innerHTML = "<span>🔊</span> 开启音乐"

        # 保存分数按钮事件
        def handle_save_score(e):
            name = document["player-name"].value.strip() or "匿名玩家"
            save_score(name, score)
            document["player-input"].style.display = "none"
            document["player-name"].value = ""

        # 绑定事件
        document.addEventListener("keydown", handle_key)
        document["restart"].bind("click", lambda e: init_game())
        document["toggleMusic"].bind("click", toggle_music)
        document["save-score"].bind("click", handle_save_score)

        # 启动游戏
        init_game()
    </script>
</body>
</html>
